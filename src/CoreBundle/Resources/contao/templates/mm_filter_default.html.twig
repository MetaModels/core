<!-- indexer::stop -->
{% block section %}
<section class="{{ class|default('') }} block"{{ cssID|default('')|raw }}{% if style|default('') %} style="{{ style }}"{% endif %}>
    {% block headline %}
        {% if headline|default('') %}
            <{{ hl }}>{{ headline|raw }}</{{ hl }}>
        {% endif %}
    {% endblock %}
    {% block form %}
    <form{% if action|default('') %} action="{{ action }}"{% endif %} method="post">
        {# Required for submitting the form - override only deliberately. #}
        {% block form_hidden %}
            <input name="REQUEST_TOKEN" type="hidden" value="{{ requestToken|default('') }}"/>
            <input type="hidden" name="FORM_SUBMIT" value="{{ formid|default('') }}">
        {% endblock %}
        <div class="formbody">
            {% block filters %}
                {% for filter in filters|default([]) %}
                    {% block filter %}
                        <div class="widget {{ filter.class|default('') }}"{{ filter.cssID|default('')|raw }}>
                            {{ filter.value|raw }}
                        </div>
                    {% endblock %}
                {% endfor %}
            {% endblock %}
            {% block submit %}
                {% if submit|default('') %}
                    <div class="submit_container">
                        <input type="submit" class="submit" value="{{ submit }}">
                    </div>
                {% endif %}
            {% endblock %}
        </div>
    </form>
    {% endblock %}
</section>
{% endblock %}
<!-- indexer::continue -->
