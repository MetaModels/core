{#
    MetaModels prerendered item list - Twig version of metamodel_prerendered.html5.
#}
{% if data|default([])|length %}
    <div class="layout_full">
        {% for item in data %}
            {% block item %}
                {% set html5vals = item.html5|default({}) %}
                {% set textvals = item.text|default({}) %}
                <div class="item {{ item.class }}">
                    {% for field, name in item.attributes %}
                        {% set value = html5vals[field] is defined ? html5vals[field] : (textvals[field] is defined ? textvals[field] : null) %}
                        {% if value is not null %}
                            {# Since 2.5 the attribute templates render this block themselves. The option
                               "legacyAttributeWrapper" keeps it here for render settings that predate the change. #}
                            {% if view.get('legacyAttributeWrapper') %}
                            <div class="field {{ field }}">
                                {% if not view.get('hideLabels') %}
                                    <div class="label">{{ 'field_label'|trans({'%field_label%': name}, 'metamodels_list') }}</div>
                                {% endif %}
                                <div class="value"> {{ value|raw }}</div>
                            </div>
                            {% else %}
                                {{ value|raw }}
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                    {% block actions %}
                        <div class="actions">
                            {% for action in item.actions %}
                                {{ include('@Contao/mm_actionbutton.html.twig', {action: action}) }}
                            {% endfor %}
                        </div>
                    {% endblock %}
                </div>
            {% endblock %}
        {% endfor %}
    </div>
{% else %}
    {% block noItem %}
        <p class="info">{{ noItemsMsg|default('')|raw }}</p>
    {% endblock %}
{% endif %}
