{#
    MetaModels unrendered item list, plain text - Twig version of metamodel_unrendered.text.
#}
{%- if items.getCount() -%}
    {%- for item in items.parseAll('text', view) -%}
        {%- set textvals = item.text|default({}) -%}
        {%- for field, attr in items.getMetaModel().getAttributes() -%}
            {%- set value = textvals[field] is defined ? textvals[field] : null -%}
            {%- if value -%}
                {%- if not view.get('hideLabels') -%}{{ (('field_label'|trans({'%field_label%': attr.getName()}, 'metamodels_list'))|trim) ~ ' ' }}{%- endif -%}{{ value|raw }}{{ "\n" }}
            {%- endif -%}
        {%- endfor -%}
        {%- for action in item.actions -%}
            {{ action.label }}: {{ action.href }}{{ "\n" }}
        {%- endfor -%}
    {%- endfor -%}
{%- else -%}
    {{ noItemsMsg|default('')|raw }}
{%- endif -%}
